{
  "name": "@rljson/io-indexed-db",
  "version": "0.0.1",
  "description": "Persists rljson data into the browser's IndexedDB",
  "homepage": "https://github.com/rljson/io-indexed-db",
  "bugs": "https://github.com/rljson/io-indexed-db/issues",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rljson/io-indexed-db.git"
  },
  "main": "dist/io-indexed-db.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm vite build && tsc && node scripts/copy-readme-to-dist.js && node scripts/copy-file.js src/example.ts dist/src",
    "test": "pnpm installConformanceTests && pnpm vitest --coverage --no-file-parallelism --run  && pnpm run lint",
    "prebuild": "pnpm run test",
    "prepublishOnly": "pnpm run build",
    "lint": "pnpm eslint",
    "updateGoldens": "cross-env UPDATE_GOLDENS=true pnpm test",
    "installConformanceTests": "node scripts/install-conformance-tests.js"
  },
  "devDependencies": {
    "@rljson/dna-rljson": "^0.2.0",
    "@tssuite/helix-js": "^0.2.1",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "@vitest/coverage-v8": "^4.0.16",
    "cross-env": "^10.1.0",
    "eslint": "~9.39.2",
    "eslint-plugin-jsdoc": "^61.5.0",
    "eslint-plugin-tsdoc": "^0.5.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.5.0",
    "jsdoc": "^4.0.5",
    "read-pkg": "^10.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.1",
    "vite": "^7.3.0",
    "vite-node": "^5.2.0",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.16",
    "vitest-dom": "^0.1.1"
  },
  "dependencies": {
    "@rljson/hash": "^0.0.18",
    "@rljson/io": "^0.0.69",
    "@rljson/is-ready": "^0.0.17",
    "@rljson/json": "^0.0.23",
    "@rljson/rljson": "^0.0.76"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.21.0"
}
